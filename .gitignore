# 依赖与构建产物
node_modules/
dist/
dist-electron/
build/
out/
release/

# 运行时数据与本地配置隔离
config.json
workspace.json
plans/

# 日志与临时缓存
*.log
*.tmp
*.temp
.cache/
cache/
temp/
videoCutTool_tmp/

