*.mp4
*.mkv
*.avi
*.mov
*.flv
*.m2ts
slices/
output/
# 保护 TypeScript 源码，仅排除根目录与媒体目录下的测试视频
!*.config.ts
!src/**/*.ts
!electron/**/*.ts
!tests/**/*.ts
!scripts/**/*.ts

