{
  "name": "videocuttool",
  "version": "1.0.0",
  "description": "VideoCutTool - Motrix 风格极简无损视频裁剪桌面工具",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "node scripts/build-stream-player.cjs",
    "prebuild": "node scripts/build-stream-player.cjs",
    "dev": "vite",
    "build": "tsc && vite build && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron",
    "package": "npm run build && electron-builder --win dir --config scripts/electron-builder.cjs",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.videocuttool.app",
    "productName": "VideoCutTool",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "type": "module",
  "dependencies": {
    "lucide-react": "^0.475.0",
    "mpegts.js": "1.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.25.12",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.5"
  }
}
